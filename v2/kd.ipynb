            root=OXFORD_ROOT,
            split="trainval",
            expected_len=total_size,
        )

        train_idx, val_idx = stratified_train_val_indices(
            labels=labels,
            val_fraction=0.2,
            seed=SPLIT_SEED,
        )

        val_dataset = OxfordSSL(
            root=OXFORD_ROOT,
            split="trainval",
            train=False,
            labels=labels,
            labeled_flags=np.ones(total_size, dtype=bool),
        )

        def make_train_dataset(labeled_flags):
            return OxfordSSL(
                root=OXFORD_ROOT,
                split="trainval",
                train=True,
                labels=labels,
                labeled_flags=labeled_flags,
            )

    elif DATASET == "isic":
        isic_pairs = collect_isic_paths(ISIC_IMAGE_DIR, ISIC_MASK_DIR)

        total_size = len(isic_pairs)
        labels = np.zeros(total_size, dtype=np.int64)

        train_idx, val_idx = random_train_val_indices(
            total_size=total_size,
            val_fraction=ISIC_VAL_FRACTION,
            seed=SPLIT_SEED,
        )

        val_dataset = ISICSSL(
            pairs=isic_pairs,
            train=False,
            labeled_flags=np.ones(total_size, dtype=bool),
        )

        def make_train_dataset(labeled_flags):
            return ISICSSL(
                pairs=isic_pairs,
                train=True,
                labeled_flags=labeled_flags,
            )

    else:
        raise ValueError("DATASET must be either 'oxford' or 'isic'.")

    print(f"Total images: {total_size}", flush=True)
    print(f"Training images: {len(train_idx)}", flush=True)
    print(f"Validation images: {len(val_idx)}", flush=True)

    # ----------------------------------------
    # Experiment C configs
    # ----------------------------------------
    configs = [
        {
            "name": "SegOnly",
            "recon": False,
            "distill": False,
            "recon_weight": 0.0,
        },
        {
            "name": "Seg_Recon_0.010",
            "recon": True,
            "distill": False,
            "recon_weight": 0.010,
        },
        {
            "name": "Seg_Recon_0.005",
            "recon": True,
            "distill": False,
            "recon_weight": 0.005,
        },
        {
            "name": "Seg_Distill",
            "recon": False,
            "distill": True,
            "recon_weight": 0.0,
        },
        {
            "name": "Seg_Distill_Recon_0.010",
            "recon": True,
            "distill": True,
            "recon_weight": 0.010,
        },
        {
            "name": "Seg_Distill_Recon_0.005",
            "recon": True,
            "distill": True,
            "recon_weight": 0.005,
        },
    ]

    any_distill = any(cfg["distill"] for cfg in configs)
    any_recon = any(cfg["recon"] for cfg in configs)

    teacher_model = None
    teacher_dim = 384

    if any_distill:
        print("Loading DINOv2 teacher...", flush=True)
        teacher_model = DINOv2Teacher(device).to(device)
        teacher_dim = teacher_model.embed_dim

    perceptual_loss = None

    if any_recon:
        print("Loading LPIPS perceptual loss...", flush=True)
        perceptual_loss = lpips.LPIPS(net="vgg").to(device)
        perceptual_loss.eval()

        for p in perceptual_loss.parameters():
            p.requires_grad = False

    results_csv = "./outputs/experiment_c_results.csv"
    summary = []

    for training_seed in SEEDS:
        print("\n" + "=" * 70)
        print(f"SEED: {training_seed}")
        print("=" * 70, flush=True)

        seed_everything(training_seed)

        # Reference initialization for this seed.
        reference_model = ConvNeXtUNet(
            num_seg_classes=1,
            teacher_dim=teacher_dim,
            pretrained=True,
        ).to(device)

        reference_state = {
            k: v.detach().cpu().clone()
            for k, v in reference_model.state_dict().items()
        }

        del reference_model
        torch.cuda.empty_cache()
        gc.collect()

        for label_fraction in LABEL_FRACTIONS:
            label_tag = f"{int(round(label_fraction * 100))}pct"

            print("\n" + "=" * 70)
            print(f"LABEL FRACTION: {label_fraction:.2f}")
            print("=" * 70, flush=True)

            labeled_train_idx = select_label_fraction(
                labels=labels,
                indices=train_idx,
                fraction=label_fraction,
                seed=SPLIT_SEED,
            )

            labeled_flags = np.zeros(total_size, dtype=bool)
            labeled_flags[labeled_train_idx] = True

            num_train = len(train_idx)
            num_labeled = int(labeled_flags[np.asarray(train_idx)].sum())

            print(f"Training split size: {num_train}", flush=True)
            print(f"Labeled training images: {num_labeled}", flush=True)
            print(f"Unlabeled training images: {num_train - num_labeled}", flush=True)

            train_dataset = make_train_dataset(labeled_flags)

            for cfg in configs:
                print("\n" + "-" * 70)
                print(
                    f"Training: {cfg['name']} | Seed: {training_seed} | Labels: {label_tag}"
                )
                print("-" * 70, flush=True)

                # Reset RNG for each ablation for fair comparison.
                seed_everything(training_seed)

                train_loader = make_train_loader(
                    dataset=train_dataset,
                    indices=train_idx,
                    labeled_flags=labeled_flags,
                    batch_size=BATCH_SIZE,
                    seed=training_seed,
                    num_workers=NUM_WORKERS,
                )

                val_loader = make_eval_loader(
                    dataset=val_dataset,
                    indices=val_idx,
                    batch_size=BATCH_SIZE,
                    seed=training_seed,
                    num_workers=NUM_WORKERS,
                )

                model = ConvNeXtUNet(
                    num_seg_classes=1,
                    teacher_dim=teacher_dim,
                    pretrained=False,
                ).to(device)

                model.load_state_dict(reference_state)

                loss_weights = BASE_LOSS_WEIGHTS.copy()
                loss_weights["recon"] = cfg["recon_weight"]

                criterion = CompositeLoss(
                    teacher_model=teacher_model if cfg["distill"] else None,
                    lpips_loss=perceptual_loss if cfg["recon"] else None,
                    use_recon=cfg["recon"],
                    use_distill=cfg["distill"],
                    loss_weights=loss_weights,
                ).to(device)

                best_state, best_iou, best_dice, best_results = train_model(
                    model=model,
                    train_loader=train_loader,
                    val_loader=val_loader,
                    criterion=criterion,
                    device=device,
                    num_epochs=NUM_EPOCHS,
                    use_recon=cfg["recon"],
                    lpips_loss=perceptual_loss if cfg["recon"] else None,
                )

                ckpt_path = (
                    f"checkpoints/"
                    f"{DATASET}_"
                    f"label_{label_tag}_"
                    f"seed_{training_seed}_"
                    f"{cfg['name']}.pth"
                )

                torch.save(best_state, ckpt_path)

                print(f"Saved checkpoint: {ckpt_path}", flush=True)
                print(f"Best IoU: {best_iou:.4f}", flush=True)
                print(f"Best Dice: {best_dice:.4f}", flush=True)

                append_results_csv(
                    results_csv,
                    [
                        DATASET,
                        label_fraction,
                        training_seed,
                        cfg["name"],
                        cfg["recon_weight"],
                        int(cfg["recon"]),
                        int(cfg["distill"]),
                        best_iou,
                        best_dice,
                        best_results.get("ssim", ""),
                        best_results.get("psnr", ""),
                        best_results.get("lpips", ""),
                    ],
                )

                summary.append(
                    f"{DATASET} | Seed {training_seed} | Labels {label_tag} | "
                    f"{cfg['name']} | IoU {best_iou:.4f} | Dice {best_dice:.4f}"
                )

                del model, criterion, train_loader, val_loader, best_state
                torch.cuda.empty_cache()
                gc.collect()

            del train_dataset
            torch.cuda.empty_cache()
            gc.collect()

    print("\n" + "=" * 70)
    print("FINAL SUMMARY")
    print("=" * 70, flush=True)

    for line in summary:
        print(line, flush=True)

    print("\nSCRIPT COMPLETED SUCCESSFULLY", flush=True)
